# Required. Supabase publishable (anon) key for project dzlmtvodpyhetvektfuo.
# The app refuses to start with a clear error when this is missing or malformed.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Defaults to https://dzlmtvodpyhetvektfuo.supabase.co when unset.
VITE_SUPABASE_URL=

# Optional. Commit shown in /build-info.json and window.__BUILD_INFO__.
# Falls back to VERCEL_GIT_COMMIT_SHA, then `git rev-parse HEAD`, at build time.
VITE_COMMIT_SHA=
